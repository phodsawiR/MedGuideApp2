rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function syncAdmin() {
      return verifiedGoogle() && request.auth.token.email.lower() == 'phodsawi.2547@gmail.com';
    }
    function syncAllowed() {
      return verifiedGoogle()
        && get(/databases/$(database)/documents/practiceSyncAllowlist/$(request.auth.token.email.lower())).data.active == true;
    }
    // Preserve existing access for other data; never bypass quiz owner rules.
    match /{topCollection}/{document=**} {
      allow read, write: if topCollection != 'quizAnswerCorrections'
        && topCollection != 'practiceProgress' && topCollection != 'practiceSyncAllowlist'
        && topCollection != 'osceContent' && topCollection != 'osceImages'
        && topCollection != 'osceProgress';
    }
    function osceAllowed() {
      return verifiedGoogle() && request.auth.token.email.lower() == 'royalrarityruj@gmail.com';
    }
    // OSCE is limited to the approved account; progress belongs to each UID.
    match /osceContent/{document} {
      allow read: if osceAllowed();
      allow create, update: if syncAdmin();
      allow delete: if false;
    }
    match /osceImages/{document=**} {
      allow read: if osceAllowed();
      allow create, update: if syncAdmin();
      allow delete: if false;
    }
    match /osceProgress/{uid}/cards/{cardId} {
      function ownsOsceProgress() {
        return osceAllowed() && request.auth.uid == uid;
      }
      allow read: if ownsOsceProgress();
      allow create, update: if ownsOsceProgress()
        && cardId.size() <= 200
        && request.resource.data.keys().hasOnly(['v','updatedAt','clientUpdatedAt','dueAt','intervalDays','ease','reps','lapses','rating','response'])
        && request.resource.data.v == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.clientUpdatedAt is number
        && request.resource.data.dueAt is number && request.resource.data.dueAt >= 0
        && request.resource.data.intervalDays is number && request.resource.data.intervalDays >= 0
        && request.resource.data.ease is number && request.resource.data.ease >= 1.3 && request.resource.data.ease <= 5
        && request.resource.data.reps is int && request.resource.data.reps >= 0
        && request.resource.data.lapses is int && request.resource.data.lapses >= 0
        && request.resource.data.rating in ['', 'again','hard','good','easy']
        && request.resource.data.response is string && request.resource.data.response.size() <= 12000;
      allow delete: if false;
    }
    match /practiceSyncAllowlist/{email} {
      allow get: if syncAdmin() || (verifiedGoogle() && request.auth.token.email.lower() == email);
      allow list: if syncAdmin();
      allow create, update: if syncAdmin() && email.size() <= 254
        && email.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
        && request.resource.data.keys().hasOnly(['active','updatedAt','updatedBy'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
match /practiceProgress/{uid}/banks/{bank} {
  function ownsProgress() {
    return syncAllowed() && request.auth.uid == uid;
  }
  allow read: if ownsProgress();
  allow create, update: if ownsProgress()
    && bank in ['caseflow_mcq_practice_v1','caseflow_ped_mcq_practice_v1','caseflow_med_ped_mcq_practice_v1']
    && request.resource.data.keys().hasOnly(['v','entries','reset','settings','resume'])
    && request.resource.data.v == 1 && request.resource.data.entries is map;
  allow delete: if false;
}
// Merge inside match /databases/{database}/documents in the existing rules.
// A broad overlapping allow rule must NOT grant writes to this collection.
match /quizAnswerCorrections/{correctionId} {
  function owner() {
    return request.auth != null
      && request.auth.token.email == 'phodsawi.2547@gmail.com'
      && request.auth.token.email_verified == true
      && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function valid(d) {
    return d.keys().hasOnly(['bank','questionId','answer','reason','fingerprint','revision','updatedAt','updatedBy'])
      && d.bank == 'ped' && d.questionId is string && d.questionId.size() <= 200
      && d.answer in ['A','B','C','D','E']
      && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 2000
      && d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$')
      && d.revision is int && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
  }
  allow read: if true;
  allow create: if owner() && valid(request.resource.data) && request.resource.data.revision == 1
    && getAfter(/databases/$(database)/documents/quizAnswerCorrections/$(correctionId)/history/1).data == request.resource.data;
  allow update: if owner() && valid(request.resource.data)
    && request.resource.data.questionId == resource.data.questionId
    && request.resource.data.revision == resource.data.revision + 1
    && getAfter(/databases/$(database)/documents/quizAnswerCorrections/$(correctionId)/history/$(request.resource.data.revision)).data == request.resource.data;
  allow delete: if false;
  match /history/{revisionId} {
    allow read: if owner();
    allow create: if owner() && valid(request.resource.data)
      && getAfter(/databases/$(database)/documents/quizAnswerCorrections/$(correctionId)).data == request.resource.data;
    allow update, delete: if false;
  }
}

  }
}
